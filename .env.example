# Shared backend origin. Use http://localhost:4000 only when running the backend locally.
VITE_API_URL=https://skillcred-backend-fc5i.onrender.com
# For local development against the shared backend, create .env.development.local
# containing VITE_API_URL=/api to use the API proxy in vite.config.ts.
# Keep this override in the development file so production keeps its backend URL.
# Public Google OAuth web client ID. Never add a client secret to VITE_* variables.
VITE_GOOGLE_CLIENT_ID=404625712441-ltfk8ubo8ncuc9hu9hnpd12lo88fmirn.apps.googleusercontent.com
